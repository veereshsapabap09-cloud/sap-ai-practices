<?xml version="1.0" encoding="utf-8"?>
<!--
  Behavior definition (Phase 5)
  Name: ZRAP_DEMO_BP.behavior.xml
  Purpose: Declares the RAP behavioral contract for the Department (root) and Employee (child) projections.
  Note: This file is a ADT/abapGit-friendly representation of the behavior definition. The implementation (methods and ABAP classes) will be created in Phase 6.
-->
<behavior-definition>
  <metadata>
    <package>ZRAP_DEMO</package>
    <prefix>ZRAP_DEMO_</prefix>
    <description>Behavior Definition: Department/Employee RAP demo (managed, draft-enabled)</description>
    <author>veereshsapabap09-cloud</author>
  </metadata>

  <!-- Root entity: Department -->
  <entity name="P_ZRAP_DEMO_DEPT" role="root" managed="true" draft-enabled="true">
    <projection>P_ZRAP_DEMO_DEPT</projection>

    <!-- Composition to child entity -->
    <composition target="P_ZRAP_DEMO_EMP" cardinality="0..*"/>

    <!-- Determinations: called during create/prepare/activate -->
    <determinations>
      <determination name="/ZRAP_DEMO/GenerateDepartmentID" when="prepare,save,activate" handlerClass="ZRAP_DEMO_NUMGEN" handlerMethod="generate_department_id" description="Late numbering for DepartmentID"/>
      <determination name="/ZRAP_DEMO/PopulateDeptAudit" when="create,change" handlerClass="ZRAP_DEMO_UTIL" handlerMethod="populate_audit_fields" description="Populate CreatedBy/CreatedOn/ChangedBy/ChangedOn"/>
      <determination name="/ZRAP_DEMO/DefaultStatus" when="create" handlerClass="ZRAP_DEMO_UTIL" handlerMethod="default_status" description="Set default Status to Active ('A')"/>
    </determinations>

    <!-- Validations: transactional checks for Department -->
    <validations>
      <validation name="/ZRAP_DEMO/ValidateDeptName" when="save" handlerClass="ZRAP_DEMO_VAL" handlerMethod="validate_department_name" description="DepartmentName mandatory"/>
    </validations>

    <!-- Instance actions on Department -->
    <actions>
      <action name="ActivateDepartment" type="instance" handlerClass="ZRAP_DEMO_ACTION" handlerMethod="activate_department" description="Activate prepared department draft"/>
      <action name="CloseDepartment" type="instance" handlerClass="ZRAP_DEMO_ACTION" handlerMethod="close_department" description="Mark department status as Closed"/>
      <action name="ReopenDepartment" type="instance" handlerClass="ZRAP_DEMO_ACTION" handlerMethod="reopen_department" description="Re-open a closed department"/>
    </actions>

    <!-- Factory action: copy department including child employees -->
    <factory-actions>
      <action name="CopyDepartment" handlerClass="ZRAP_DEMO_ACTION" handlerMethod="copy_department" returns="P_ZRAP_DEMO_DEPT" description="Create a full copy of department including employees"/>
    </factory-actions>

    <!-- Feature controls and instance feature rules -->
    <feature-controls>
      <feature name="CanEdit" default="true">
        <condition whenField="Status" operator="=" value="C" result="false" description="Disable edit when Department is Closed"/>
      </feature>
      <feature name="CanDelete" default="true">
        <condition whenField="Status" operator="=" value="C" result="false" description="Disable delete when Department is Closed"/>
      </feature>
    </feature-controls>

    <!-- Authorization stub (to be replaced by real checks) -->
    <authorization>
      <check name="ZRAP_DEMO_AUTH" handlerClass="ZRAP_DEMO_UTIL" handlerMethod="auth_check" description="Placeholder for authorization checks"/>
    </authorization>

  </entity>

  <!-- Child entity: Employee (composition under Department) -->
  <entity name="P_ZRAP_DEMO_EMP" role="child" managed="true" draft-enabled="true">
    <projection>P_ZRAP_DEMO_EMP</projection>

    <!-- Determinations for child -->
    <determinations>
      <determination name="/ZRAP_DEMO/GenerateEmployeeID" when="prepare,save,activate" handlerClass="ZRAP_DEMO_NUMGEN" handlerMethod="generate_employee_id" description="Late numbering for EmployeeID"/>
      <determination name="/ZRAP_DEMO/PopulateEmpAudit" when="create,change" handlerClass="ZRAP_DEMO_UTIL" handlerMethod="populate_audit_fields" description="Populate CreatedBy/CreatedOn/ChangedBy/ChangedOn"/>
    </determinations>

    <!-- Validations for Employee -->
    <validations>
      <validation name="/ZRAP_DEMO/ValidateEmployeeName" when="save" handlerClass="ZRAP_DEMO_VAL" handlerMethod="validate_employee_name" description="EmployeeName mandatory"/>
      <validation name="/ZRAP_DEMO/ValidateSalary" when="save" handlerClass="ZRAP_DEMO_VAL" handlerMethod="validate_salary" description="Salary cannot be negative"/>
      <validation name="/ZRAP_DEMO/ValidateJoiningDate" when="save" handlerClass="ZRAP_DEMO_VAL" handlerMethod="validate_joining_date" description="Joining date cannot be future"/>
      <validation name="/ZRAP_DEMO/ValidateEmail" when="save" handlerClass="ZRAP_DEMO_VAL" handlerMethod="validate_email" description="Email format validation"/>
      <validation name="/ZRAP_DEMO/CheckDuplicateEmployee" when="save" handlerClass="ZRAP_DEMO_VAL" handlerMethod="check_duplicate_employee" description="Duplicate employee validation inside same department"/>
    </validations>

    <!-- Instance actions for Employee -->
    <actions>
      <action name="PromoteEmployee" type="instance" handlerClass="ZRAP_DEMO_ACTION" handlerMethod="promote_employee" description="Promote employee (may change designation)">
        <feature-control name="HidePromote" default="false">
          <condition whenField="IsManager" operator="=" value="X" result="true" description="Hide promote when the employee is already a manager"/>
        </feature-control>
      </action>
      <action name="DeactivateEmployee" type="instance" handlerClass="ZRAP_DEMO_ACTION" handlerMethod="deactivate_employee" description="Mark employee as inactive"/>
    </actions>

    <!-- Instance feature to disable delete when parent department closed -->
    <feature-controls>
      <feature name="CanDelete" default="true">
        <condition whenField="/P_ZRAP_DEMO_DEPT/Status" operator="=" value="C" result="false" description="Disable delete when parent department is Closed"/>
      </feature>
    </feature-controls>

    <!-- Authorization stub for employee-specific checks -->
    <authorization>
      <check name="ZRAP_DEMO_EMP_AUTH" handlerClass="ZRAP_DEMO_UTIL" handlerMethod="auth_check_emp" description="Placeholder for employee auth checks"/>
    </authorization>

  </entity>

  <!-- Lock handling and draft hints -->
  <locks>
    <useDraftLocking>true</useDraftLocking>
    <notes>Standard RAP draft locking will be used. Special locking behavior (if any) to be implemented in the behavior implementation classes.</notes>
  </locks>

  <!-- Mapping of determinations/validations/actions to ABAP implementation classes (Phase 6) -->
  <implementation-map>
    <class name="ZRAP_DEMO_NUMGEN" path="src/classes/ZRAP_DEMO_NUMGEN.clas.abap">Number generator for late numbering (GenerateDepartmentID, GenerateEmployeeID)</class>
    <class name="ZRAP_DEMO_VAL" path="src/classes/ZRAP_DEMO_VAL.clas.abap">Validation helper (email, salary, joining date, duplicate checks)</class>
    <class name="ZRAP_DEMO_ACTION" path="src/classes/ZRAP_DEMO_ACTION.clas.abap">Action helper for Activate/Close/Reopen/Copy/Promote/Deactivate</class>
    <class name="ZRAP_DEMO_UTIL" path="src/classes/ZRAP_DEMO_UTIL.clas.abap">Utility & authorization stubs; audit field population</class>
  </implementation-map>

</behavior-definition>
