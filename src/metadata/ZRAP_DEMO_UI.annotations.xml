<?xml version="1.0" encoding="utf-8"?>
<Annotations Target="ZRAP_DEMO::P_ZRAP_DEMO_DEPT">
  <!-- Object Page / Header -->
  <Annotation Term="UI.HeaderInfo">
    <Record>
      <PropertyValue Property="Type" String="Standard"/>
      <PropertyValue Property="Title" Path="DepartmentName"/>
      <PropertyValue Property="Description" Path="Status"/>
    </Record>
  </Annotation>

  <!-- Identification section -->
  <Annotation Term="UI.Identification">
    <Collection>
      <Record>
        <PropertyValue Property="Label" String="Department ID"/>
        <PropertyValue Property="Value" Path="DepartmentID"/>
      </Record>
      <Record>
        <PropertyValue Property="Label" String="Department Name"/>
        <PropertyValue Property="Value" Path="DepartmentName"/>
      </Record>
      <Record>
        <PropertyValue Property="Label" String="Manager"/>
        <PropertyValue Property="Value" Path="Manager"/>
      </Record>
      <Record>
        <PropertyValue Property="Label" String="Status"/>
        <PropertyValue Property="Value" Path="Status"/>
      </Record>
    </Collection>
  </Annotation>

  <!-- Facets: Employees table as a section on the object page -->
  <Annotation Term="UI.Facets">
    <Collection>
      <Record Type="UI.ReferenceFacet">
        <PropertyValue Property="Label" String="Employees"/>
        <PropertyValue Property="Target">
          <Record Type="UI.AnnotationPath">
            <PropertyValue Property="Annotations" String="com.sap.vocabularies.UI.v1.LineItem"/>
            <PropertyValue Property="Target" String="_Employees"/>
          </Record>
        </PropertyValue>
      </Record>
    </Collection>
  </Annotation>

  <!-- Header actions (wire to behavior actions) -->
  <Annotation Term="UI.HeaderFacets">
    <Collection>
      <Record>
        <PropertyValue Property="Label" String="Actions"/>
      </Record>
    </Collection>
  </Annotation>

  <!-- Action annotations: map behavior actions to UI actions (placeholders) -->
  <Annotation Term="com.sap.vocabularies.Common.v1.Action" String="ActivateDepartment"/>
  <Annotation Term="com.sap.vocabularies.Common.v1.Action" String="CloseDepartment"/>
  <Annotation Term="com.sap.vocabularies.Common.v1.Action" String="ReopenDepartment"/>
  <Annotation Term="com.sap.vocabularies.Common.v1.Action" String="CopyDepartment"/>

</Annotations>
